# Enterprise AI Knowledge Platform Environment Configuration

# Server Settings
APPLICATION_ENV=development
APPLICATION_HOST=0.0.0.0
APPLICATION_PORT=8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET=change-this-to-a-secure-jwt-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_DB=enterprise_ai_db
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/enterprise_ai_db

# Cache & Message Broker (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Vector Database (Qdrant)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Search Engine (OpenSearch)
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_URL=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# Object Storage (MinIO)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=enterprise-ai-documents
MINIO_SECURE=false

# AI Model Gateway & Ollama Runtime
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
RERANKER_MODEL=bge-reranker-large
VISION_MODEL=qwen2-vl:7b

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json
